    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Listar vehículos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Driver-Id",
                "value": "{{driverId}}"
              },
              {
                "key": "X-Driver-Name",
                "value": "{{driverName}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "description": "GET /api/vehicles — lista con estado (available/on-trip). Guarda el primer vehículo de la respuesta en las variables de entorno vehicleId/vehiclePlate para el resto de la colección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve un array', () => Array.isArray(body));",
                  "if (Array.isArray(body) && body.length > 0) {",
                  "  const v = body[0];",
                  "  pm.environment.set('vehicleId', v.id);",
                  "  pm.environment.set('vehiclePlate', v.plate);",
                  "  console.log('vehicleId guardado:', v.id, v.plate, v.status);",
                  "} else {",
                  "  console.warn('No hay vehículos en la base — insertá al menos uno (ver descripción de la colección) antes de seguir.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Photos",
      "item": [
        {
          "name": "Subir foto de defecto",
          "request": {
            "method": "POST",
            "header": [
