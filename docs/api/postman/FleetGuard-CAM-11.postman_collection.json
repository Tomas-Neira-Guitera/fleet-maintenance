                "key": "X-Driver-Id",
                "value": "{{driverId}}"
              },
              {
                "key": "X-Driver-Name",
                "value": "{{driverName}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/photos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "photos"
              ]
            },
            "description": "POST /api/photos — subida en 2 pasos (paso 1). Elegí un archivo image/jpeg o image/png de menos de 8MB en el campo 'file'. Guarda photoUrl/photoId para usarlos en defect.photoUrl de una inspección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.photoUrl) {",
                  "  pm.environment.set('photoUrl', body.photoUrl);",
                  "  pm.environment.set('photoId', body.photoId);",
                  "  console.log('photoUrl guardada:', body.photoUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener foto subida",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/photos/{{photoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "photos",
                "{{photoId}}"
              ]
            },
            "description": "GET /api/photos/{id} — sirve el archivo subido. Detalle de implementación (no forma parte del OpenAPI formal) para verificar que photoUrl resuelve a algo real."
          }
