    {
      "name": "Inspections — Flujo feliz",
      "item": [
        {
          "name": "Pre-trip — sin defectos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Driver-Id",
                "value": "{{driverId}}"
              },
              {
                "key": "X-Driver-Name",
                "value": "{{driverName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"pre-trip\",\n  \"answers\": [\n    { \"itemId\": \"ext-luces\", \"outcome\": \"ok\" },\n    { \"itemId\": \"ext-neumaticos\", \"outcome\": \"ok\" },\n    { \"itemId\": \"ext-carroceria\", \"outcome\": \"ok\" },\n    { \"itemId\": \"ext-fugas\", \"outcome\": \"ok\" },\n    { \"itemId\": \"int-km\", \"numberValue\": 82430 },\n    { \"itemId\": \"int-documentacion\", \"outcome\": \"ok\" },\n    { \"itemId\": \"int-testigos\", \"outcome\": \"ok\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inspections/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "{{vehicleId}}"
              ]
            },
            "description": "Abre un viaje para {{vehicleId}}. Requiere haber corrido antes 'Listar vehículos' para tener vehicleId seteado, y que ese vehículo esté 'available' (sin viaje abierto)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('abre el viaje (trip.status = open)', () => body.trip && body.trip.status === 'open');",
                  "pm.test('sin defectos bloqueantes', () => body.inspection.hasBlockingDefect === false);",
                  "if (body.trip) pm.environment.set('tripId', body.trip.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pre-trip — con defecto bloqueante (usa foto subida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Driver-Id",
                "value": "{{driverId}}"
              },
              {
                "key": "X-Driver-Name",
                "value": "{{driverName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"pre-trip\",\n  \"answers\": [\n    { \"itemId\": \"ext-luces\", \"outcome\": \"ok\" },\n    {\n      \"itemId\": \"ext-neumaticos\",\n      \"outcome\": \"defect\",\n      \"defect\": {\n        \"severity\": \"blocking\",\n        \"description\": \"Neumático delantero derecho con corte visible en el lateral, se ve la trama por dentro.\",\n        \"photoUrl\": \"{{photoUrl}}\"\n      }\n    },\n    { \"itemId\": \"ext-carroceria\", \"outcome\": \"ok\" },\n    { \"itemId\": \"ext-fugas\", \"outcome\": \"ok\" },\n    { \"itemId\": \"int-km\", \"numberValue\": 82430 },\n    { \"itemId\": \"int-documentacion\", \"outcome\": \"ok\" },\n    { \"itemId\": \"int-testigos\", \"outcome\": \"ok\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inspections/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "{{vehicleId}}"
              ]
            },
            "description": "Igual que 'Pre-trip — sin defectos' pero reporta Neumáticos como defecto bloqueante. Corré antes 'Subir foto de defecto' para tener {{photoUrl}} seteada. Usa un vehicleId que esté 'available' (si ya corriste la request anterior sobre el mismo vehículo, va a dar 409 — probá con otro vehículo o mirá la carpeta de errores)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('hasBlockingDefect = true', () => body.inspection.hasBlockingDefect === true);",
                  "if (body.trip) pm.environment.set('tripId', body.trip.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Post-trip — cierra el viaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Driver-Id",
                "value": "{{driverId}}"
              },
              {
                "key": "X-Driver-Name",
                "value": "{{driverName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"post-trip\",\n  \"answers\": [\n    { \"itemId\": \"post-danos\", \"outcome\": \"ok\" },\n    { \"itemId\": \"post-luces\", \"outcome\": \"ok\" },\n    { \"itemId\": \"post-fugas\", \"outcome\": \"ok\" },\n    { \"itemId\": \"post-km\", \"numberValue\": 82611 }\n  ],\n  \"notes\": \"Todo normal, sin novedades.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inspections/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "{{vehicleId}}"
              ]
            },
            "description": "Requiere que {{vehicleId}} tenga un viaje abierto (corré primero alguna de las dos requests de Pre-trip de esta misma carpeta)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('cierra el viaje (trip.status = closed)', () => body.trip && body.trip.status === 'closed');"
                ]
              }
            }
          ]
        }
      ]
    },
